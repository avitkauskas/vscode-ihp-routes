{
  "scopeName": "inline.ihp-routes",
  "fileTypes": [],
  "injectionSelector": "L:source.haskell -comment -(string -meta.embedded)",
  "patterns": [
    {
      "contentName": "meta.embedded.block.routes",
      "begin": "(\\[)(routes)(\\|)",
      "beginCaptures": {
        "1": { "name": "keyword.other" },
        "2": { "name": "entity.name.quasi-quoter" },
        "3": { "name": "keyword.other" }
      },
      "end": "(\\|\\])",
      "endCaptures": {
        "0": { "name": "keyword.other" }
      },
      "patterns": [
        {
          "match": "GET|POST|PUT|PATCH|DELETE|WS|HEAD",
          "name": "keyword.control.http"
        },
        {
          "match": "\\{(\\+?[a-zA-Z_][a-zA-Z0-9_]*)\\}",
          "name": "storage.route-param"
        },
        {
          "match": "#([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.route-param" }
          },
          "name": "punctuation.define"
        },
        {
          "match": "\\?([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.route-param" }
          },
          "name": "punctuation.definition.route-param"
        },
        {
          "match": "\\&([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.route-param" }
          },
          "name": "punctuation.definition.route-param"
        },
        {
          "match": "/[^\\s?&|{}]+",
          "name": "string path"
        },
        {
          "match": "[A-Z][A-Za-z0-9]+Action\\b",
          "name": "entity.name.function.action"
        },
        {
          "match": "--.*$",
          "name": "comment.line.double-dash"
        }
      ]
    }
  ]
}